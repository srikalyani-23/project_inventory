/* Layout */
.app-shell { min-height: 100vh; display: flex; }
.sidebar { width: 250px; background: #0f172a; color: #fff; min-height: 100vh; padding: 24px 16px; position: fixed; left: 0; top: 0; bottom: 0; display: flex; flex-direction: column; z-index: 10; }
.brand { display: flex; align-items: center; gap: 12px; padding: 0 8px 28px; border-bottom: 1px solid rgba(255,255,255,.1); }
.brand-logo { width: 38px; height: 38px; border-radius: 10px; background: #2563eb; display: grid; place-items: center; font-weight: 800; }
.brand strong { display: block; font-size: 17px; }
.brand span { display: block; font-size: 11px; color: #94a3b8; margin-top: 2px; }
.nav-menu { margin-top: 24px; display: grid; gap: 6px; }
.nav-item { color: #cbd5e1; text-decoration: none; padding: 12px; border-radius: 8px; display: flex; align-items: center; gap: 12px; font-size: 14px; }
.nav-item span { width: 18px; text-align: center; }
.nav-item:hover, .nav-item.active { background: #1e293b; color: #fff; }
.nav-item.active { box-shadow: inset 3px 0 #3b82f6; }
.sidebar-footer { margin-top: auto; }
.system-status { color: #94a3b8; font-size: 12px; padding: 12px 8px 18px; }
.status-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #22c55e; margin-right: 7px; }
.user-mini { border-top: 1px solid rgba(255,255,255,.1); padding: 18px 8px 0; display: flex; gap: 10px; align-items: center; }
.avatar, .top-avatar { width: 34px; height: 34px; border-radius: 50%; background: #334155; display: grid; place-items: center; color: #fff; font-size: 13px; font-weight: 700; }
.user-mini strong, .user-mini span { display: block; font-size: 12px; }
.user-mini span { color: #94a3b8; margin-top: 3px; }
.main-area { margin-left: 250px; width: calc(100% - 250px); min-height: 100vh; }
.topbar { height: 64px; background: rgba(255,255,255,.92); border-bottom: 1px solid #e5e7eb; display: flex; justify-content: flex-end; align-items: center; padding: 0 30px; position: sticky; top: 0; z-index: 5; }
.topbar-actions { display: flex; align-items: center; gap: 10px; }
.icon-btn { border: 0; background: transparent; cursor: pointer; font-size: 20px; padding: 7px; color: #475569; }
.top-search { width: 180px; border: 1px solid #dbe1e8; border-radius: 8px; padding: 8px 10px; outline: none; }
.mobile-brand { display: none; }
.page { padding: 30px; max-width: 1500px; margin: 0 auto; }
.page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
.page-header h1 { margin: 0 0 6px; font-size: 27px; letter-spacing: -.4px; }
.page-header p { margin: 0; color: #64748b; font-size: 14px; }
.primary-button { border: 0; background: #2563eb; color: white; padding: 11px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; }
.primary-button:hover { background: #1d4ed8; }

/* Cards */
.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-bottom: 24px; }
.kpi-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; min-width: 0; }
.kpi-top { display: flex; justify-content: space-between; align-items: center; }
.kpi-card > span, .kpi-top > span { color: #64748b; font-size: 13px; }
.kpi-card h2 { margin: 10px 0 5px; font-size: 28px; line-height: 1.2; overflow-wrap: anywhere; }
.kpi-card p { margin: 0; color: #94a3b8; font-size: 12px; }
.kpi-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 8px; background: #eff6ff; color: #2563eb; font-weight: 700; }
.kpi-value-fit { font-size: 20px !important; white-space: nowrap; }
.panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 22px; }
.panel-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 15px; margin-bottom: 18px; }
.panel-heading h2, .decision-card h2, .alerts-page-panel h2, .forecast-insight h2 { margin: 0 0 5px; font-size: 18px; }
.panel-heading p { margin: 0; color: #64748b; font-size: 13px; }
.text-link, .back-btn { color: #2563eb; text-decoration: none; font-size: 13px; font-weight: 600; }
.text-link:hover, .back-btn:hover { text-decoration: underline; }

/* Dashboard */
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(280px, .8fr); gap: 18px; margin-bottom: 24px; }
.chart-wrap { width: 100%; }
.chart-legend { display: flex; gap: 18px; color: #64748b; font-size: 12px; margin-bottom: 4px; }
.legend-line { display: inline-block; width: 18px; height: 3px; vertical-align: middle; margin-right: 5px; background: #2563eb; }
.legend-line.forecast { background: #f59e0b; }
.risk-bars { display: grid; gap: 22px; padding-top: 8px; }
.risk-label { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px; }
.risk-label span { color: #64748b; }
.bar-track { height: 8px; background: #eef2f7; border-radius: 999px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999px; background: #2563eb; }
.bar-fill.critical { background: #dc2626; }.bar-fill.low-stock { background: #d97706; }.bar-fill.overstock { background: #9333ea; }.bar-fill.healthy { background: #16a34a; }
.alert-list { display: grid; gap: 10px; }
.alert-row { display: grid; grid-template-columns: 42px minmax(150px, 1fr) 110px 110px 150px 45px; align-items: center; gap: 12px; border: 1px solid #edf0f4; border-radius: 10px; padding: 13px; }
.alert-icon { width: 38px; height: 38px; border-radius: 9px; display: grid; place-items: center; background: #fef2f2; color: #dc2626; }
.alert-icon.overstock { background: #faf5ff; color: #9333ea; }
.alert-product strong, .alert-product span, .alert-stock span, .alert-order span { display: block; }
.alert-product span, .alert-stock span, .alert-order span { color: #94a3b8; font-size: 11px; margin-top: 3px; }
.alert-stock strong, .alert-order strong { font-size: 12px; }
.small-view { color: #2563eb; text-decoration: none; font-size: 12px; font-weight: 600; }

/* Status */
.status-badge { display: inline-block; width: fit-content; padding: 5px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; white-space: nowrap; }
.status-badge.critical { background: #fee2e2; color: #b91c1c; }.status-badge.low-stock { background: #fef3c7; color: #b45309; }.status-badge.overstock { background: #f3e8ff; color: #7e22ce; }.status-badge.healthy { background: #dcfce7; color: #15803d; }

/* Inventory */
.inventory-controls { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 12px; margin-bottom: 18px; }
.inventory-controls input, .inventory-controls select, .control-group select { width: 100%; border: 1px solid #dbe1e8; border-radius: 8px; padding: 10px 12px; background: #fff; outline: none; color: #334155; }
.inventory-controls input:focus, .inventory-controls select:focus, .control-group select:focus { border-color: #93c5fd; box-shadow: 0 0 0 3px #eff6ff; }
.table-top { margin-bottom: 15px; }.table-top h2 { margin: 0 0 4px; font-size: 18px; }.table-top span { color: #94a3b8; font-size: 12px; }
.table-scroll { overflow-x: auto; }
.inventory-table { width: 100%; border-collapse: collapse; min-width: 900px; }
.inventory-table th { text-align: left; color: #64748b; background: #f8fafc; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding: 12px; }
.inventory-table td { padding: 14px 12px; border-top: 1px solid #eef2f7; font-size: 13px; }
.inventory-table td strong { font-size: 13px; }.view-btn { color: #2563eb; text-decoration: none; font-weight: 600; font-size: 12px; }.view-btn:hover { text-decoration: underline; }
.empty-state { text-align: center; padding: 40px !important; color: #64748b; }

/* Product details */
.product-info-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px 24px; margin-bottom: 18px; display: flex; gap: 80px; align-items: center; }
.product-info-card div { display: flex; flex-direction: column; gap: 7px; }.product-info-card span { color: #64748b; font-size: 12px; }.product-info-card strong { font-size: 15px; }
.forecast-panel, .risk-panel { margin-bottom: 18px; }
.risk-content { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.risk-item { border: 1px solid #edf0f4; border-radius: 9px; padding: 16px; display: flex; justify-content: space-between; gap: 12px; }
.risk-item span { color: #64748b; font-size: 13px; }.risk-high { color: #dc2626; }.risk-low { color: #16a34a; }
.decision-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 22px; margin-bottom: 40px; }
.decision-card h3 { margin: 18px 0 7px; font-size: 16px; }.decision-card p { color: #64748b; line-height: 1.6; margin: 0; }

/* Alerts */
.alert-cards { display: grid; gap: 12px; }.alert-card { border: 1px solid #edf0f4; border-radius: 10px; padding: 18px; display: flex; justify-content: space-between; align-items: center; gap: 25px; }
.alert-card-left { display: flex; align-items: center; gap: 13px; min-width: 190px; }.alert-card-left h3 { margin: 0 0 4px; font-size: 15px; }.alert-card-left span { color: #94a3b8; font-size: 12px; }
.alert-details { display: flex; align-items: center; gap: 35px; }.alert-details > div { display: flex; flex-direction: column; gap: 7px; }.alert-details > div > span { color: #94a3b8; font-size: 11px; }.alert-details > div > strong { font-size: 12px; }

/* Forecast page */
.forecast-controls-panel { display: flex; gap: 18px; margin-bottom: 18px; }.control-group { width: 230px; }.control-group label { display: block; font-size: 12px; color: #64748b; margin-bottom: 7px; }.large-chart-panel { margin-bottom: 18px; }.forecast-insight p { margin: 0; color: #64748b; line-height: 1.6; }

/* Responsive */
@media (max-width: 1100px) {
  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  .dashboard-grid { grid-template-columns: 1fr; }
  .alert-row { grid-template-columns: 42px 1fr 110px; }
  .alert-stock, .alert-order, .alert-row .small-view { display: none; }
  .alert-details { flex-wrap: wrap; }
}
@media (max-width: 800px) {
  .sidebar { width: 210px; }.main-area { margin-left: 210px; width: calc(100% - 210px); }
  .page { padding: 20px; }.inventory-controls { grid-template-columns: 1fr; }
  .alert-card { flex-direction: column; align-items: flex-start; }.alert-details { width: 100%; justify-content: space-between; gap: 18px; }
}
@media (max-width: 600px) {
  .sidebar { width: 100%; height: auto; min-height: 0; position: static; padding: 12px; }.brand { padding-bottom: 12px; }.nav-menu { margin-top: 10px; grid-template-columns: 1fr 1fr; }.nav-item { font-size: 12px; padding: 9px; }.sidebar-footer { display: none; }
  .main-area { margin-left: 0; width: 100%; }.topbar { display: none; }.mobile-brand { display: block; font-weight: 800; margin-right: auto; }
  .page-header { flex-direction: column; }.page-header h1 { font-size: 23px; }.kpi-grid { grid-template-columns: 1fr 1fr; gap: 10px; }.kpi-card { padding: 15px; }.kpi-card h2 { font-size: 23px; }
  .product-info-card { flex-direction: column; align-items: flex-start; gap: 16px; }.risk-content { grid-template-columns: 1fr; }.forecast-controls-panel { flex-direction: column; }.control-group { width: 100%; }
  .alert-details { flex-direction: column; align-items: flex-start; }.alert-row { grid-template-columns: 38px 1fr; }.alert-row .status-badge { grid-column: 2; }
}