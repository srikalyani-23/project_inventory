import { BrowserRouter, Routes, Route, NavLink } from "react-router-dom";
import { ResponsiveContainer, LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip } from "recharts";
import { useState } from "react";
import { inventorydata, forecastData } from "./data/inventorydata";
import Inventory from "./pages/Inventory";
import ProductDetails from "./pages/ProductDetails";
import Alerts from "./pages/Alerts";
import DemandForecast from "./pages/DemandForecast";
import "./App.css";

function Layout({ children }) {
  const [searchOpen, setSearchOpen] = useState(false);

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-logo">IA</div>
          <div>
            <strong>InventoryAI</strong>
            <span>Decision Support</span>
          </div>
        </div>

        <nav className="nav-menu">
          <NavLink to="/" end className="nav-item">
            <span>⌂</span> Dashboard
          </NavLink>
          <NavLink to="/inventory" className="nav-item">
            <span>▣</span> Inventory
          </NavLink>
          <NavLink to="/forecast" className="nav-item">
            <span>⌁</span> Demand Forecast
          </NavLink>
          <NavLink to="/alerts" className="nav-item">
            <span>⚠</span> Alerts & Recommendations
          </NavLink>
        </nav>

        <div className="sidebar-footer">
          <div className="system-status"><span className="status-dot" /> System Online</div>
          <div className="user-mini">
            <div className="avatar">U</div>
            <div><strong>Inventory Manager</strong><span>SME Admin</span></div>
          </div>
        </div>
      </aside>

      <main className="main-area">
        <header className="topbar">
          <div className="mobile-brand">InventoryAI</div>
          <div className="topbar-actions">
            {searchOpen && <input autoFocus className="top-search" placeholder="Search..." />}
            <button className="icon-btn" onClick={() => setSearchOpen(v => !v)} aria-label="Search">⌕</button>
            <button className="icon-btn" aria-label="Notifications">🔔</button>
            <div className="top-avatar">U</div>
          </div>
        </header>
        {children}
      </main>
    </div>
  );
}

function Dashboard() {
  const totalProducts = inventorydata.length;
  const lowStockCount = inventorydata.filter(i => i.status === "Low Stock").length;
  const reorderCount = inventorydata.filter(i => i.recommendedOrder > 0).length;
  const overstockCount = inventorydata.filter(i => i.status === "Overstock").length;

  return (
    <div className="page">
      <div className="page-header">
        <div>
          <h1>Dashboard</h1>
          <p>Overview of inventory health and demand insights</p>
        </div>
      </div>

      <div className="kpi-grid">
        <Kpi title="Total Products" value={totalProducts} note="Products tracked" icon="▣" />
        <Kpi title="Low Stock" value={lowStockCount} note="Below healthy level" icon="↓" />
        <Kpi title="Reorder Required" value={reorderCount} note="Action recommended" icon="↻" />
        <Kpi title="Overstock" value={overstockCount} note="Excess inventory" icon="↑" />
      </div>

      <div className="dashboard-grid">
        <section className="panel forecast-dashboard">
          <div className="panel-heading">
            <div><h2>Demand Forecast</h2><p>Historical vs predicted demand</p></div>
            <NavLink to="/forecast" className="text-link">View details →</NavLink>
          </div>
          <ForecastChart />
        </section>

        <section className="panel risk-overview">
          <div className="panel-heading"><div><h2>Inventory Risk</h2><p>Current stock health</p></div></div>
          <div className="risk-bars">
            <RiskBar label="Critical" count={inventorydata.filter(i => i.status === "Critical").length} total={totalProducts} />
            <RiskBar label="Low Stock" count={lowStockCount} total={totalProducts} />
            <RiskBar label="Overstock" count={overstockCount} total={totalProducts} />
            <RiskBar label="Healthy" count={inventorydata.filter(i => i.status === "Healthy").length} total={totalProducts} />
          </div>
        </section>
      </div>

      <section className="panel">
        <div className="panel-heading">
          <div><h2>Inventory Alerts</h2><p>Products requiring attention</p></div>
          <NavLink to="/alerts" className="text-link">View all →</NavLink>
        </div>
        <div className="alert-list">
          {inventorydata.filter(i => i.status !== "Healthy").map(item => (
            <div className="alert-row" key={item.id}>
              <div className={`alert-icon ${statusClass(item.status)}`}>{item.status === "Overstock" ? "📦" : "⚠"}</div>
              <div className="alert-product"><strong>{item.product}</strong><span>{item.category}</span></div>
              <StatusBadge status={item.status} />
              <div className="alert-stock"><span>Current</span><strong>{item.currentStock} units</strong></div>
              <div className="alert-order"><span>Action</span><strong>{item.recommendedOrder > 0 ? `Order ${item.recommendedOrder}` : "Do not reorder"}</strong></div>
              <NavLink to={`/inventory/${item.id}`} className="small-view">View</NavLink>
            </div>
          ))}
        </div>
      </section>
    </div>
  );
}

function Kpi({ title, value, note, icon }) {
  return <div className="kpi-card"><div className="kpi-top"><span>{title}</span><div className="kpi-icon">{icon}</div></div><h2>{value}</h2><p>{note}</p></div>;
}

function RiskBar({ label, count, total }) {
  const width = total ? Math.max((count / total) * 100, count ? 8 : 0) : 0;
  return <div className="risk-bar"><div className="risk-label"><span>{label}</span><strong>{count}</strong></div><div className="bar-track"><div className={`bar-fill ${statusClass(label)}`} style={{width: `${width}%`}} /></div></div>;
}

function StatusBadge({ status }) {
  return <span className={`status-badge ${statusClass(status)}`}>{status}</span>;
}

function statusClass(status) {
  return status.toLowerCase().replaceAll(" ", "-");
}

function ForecastChart() {
  return (
    <div className="chart-wrap">
      <div className="chart-legend">
        <span><i className="legend-line actual" /> Historical Demand</span>
        <span><i className="legend-line forecast" /> Forecasted Demand</span>
      </div>
      <ResponsiveContainer width="100%" height={280}>
        <LineChart data={forecastData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
          <CartesianGrid strokeDasharray="3 3" />
          <XAxis dataKey="date" />
          <YAxis />
          <Tooltip />
          <Line type="monotone" dataKey="actual" stroke="#2563eb" strokeWidth={3} dot={{ r: 4 }} />
          <Line type="monotone" dataKey="forecast" stroke="#f59e0b" strokeWidth={3} strokeDasharray="6 6" dot={{ r: 4 }} />
        </LineChart>
      </ResponsiveContainer>
    </div>
  );
}

export default function App() {
  return (
    <BrowserRouter>
      <Layout>
        <Routes>
          <Route path="/" element={<Dashboard />} />
          <Route path="/inventory" element={<Inventory />} />
          <Route path="/inventory/:id" element={<ProductDetails />} />
          <Route path="/alerts" element={<Alerts />} />
          <Route path="/forecast" element={<DemandForecast />} />
        </Routes>
      </Layout>
    </BrowserRouter>
  );
}